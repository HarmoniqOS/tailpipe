# Tailpipe configuration — copy to `.env` and fill in.
# `.env` is gitignored. NEVER commit real secrets. (Keys belong here, not in code.)

# ── Memory Core ───────────────────────────────────────────────────────────────
# Bearer token that guards the ingest + MCP surface. Generate a long random one:
#   python -c "import secrets; print(secrets.token_hex(24))"
INGEST_TOKEN=change-me-to-a-long-random-string

# Where the store lives (SQLite index + raw archive). Absolute path on the host.
DATA_DIR=/data

# Port the memory-core container serves on.
PORT=8080

# Comma-separated hosts/IPs allowed to reach the MCP (LAN addresses of this box
# + any client). Loosen only to what you actually use.
ALLOWED_HOSTS=127.0.0.1,localhost

# Embedding model (runs locally via fastembed). Default is a small, fast model.
EMBED_MODEL=BAAI/bge-small-en-v1.5

# ── Extraction engine ─────────────────────────────────────────────────────────
# Which model turns raw conversations into structured knowledge.
#   anthropic  — a frontier model via API (fast, high quality; costs money)
#   openai_compat — any OpenAI-compatible local/edge server (e.g. a llama.cpp box)
EXTRACT_ENGINE=anthropic

# If EXTRACT_ENGINE=anthropic. Get one at console.anthropic.com. Keep it HERE.
ANTHROPIC_API_KEY=

# If EXTRACT_ENGINE=openai_compat — any OpenAI-compatible server.
# Defaults below target a local Ollama (most common): pick a MODEL you've pulled
# and leave KEY blank. Or point URL at llama.cpp / vLLM / an edge box.
OPENAI_COMPAT_URL=http://localhost:11434/v1
OPENAI_COMPAT_KEY=
OPENAI_COMPAT_MODEL=qwen2.5:7b
